ENV=local
# Neon/Postgres connection string; leave empty to use local SQLite files
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173
GROQ_API_KEY=
# comma-separated, tried in order; a model that hits its rate limit is skipped until it resets
GROQ_CHAT_MODELS=openai/gpt-oss-120b,qwen/qwen3-32b,llama-3.3-70b-versatile,openai/gpt-oss-20b
GROQ_VISION_MODELS=meta-llama/llama-4-scout-17b-16e-instruct,meta-llama/llama-4-maverick-17b-128e-instruct
GROQ_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
GROQ_STT_MODEL=whisper-large-v3-turbo
BACKOFFICE_KEY=demo
DEMO_MODE=true
